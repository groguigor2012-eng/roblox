{
  "name": "ProtectThePumpkinFarm",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "Enemies": { "$className": "Folder" },
        "Crops": { "$className": "Folder" },
        "Weapons": { "$className": "Folder" },
        "UI": { "$className": "Folder" },
        "Effects": { "$className": "Folder" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Packages": { "$className": "Folder" },
      "Maps": { "$className": "Folder" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 60
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
